{
  "name": "recoil-tdf",
  "version": "1.0.2",
  "description": "Parser and serializer of Recoil/Spring RTS TDF format.",
  "author": "Marek Rusinowski",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2004a/recoil-tdf.git"
  },
  "scripts": {
    "gen-parser": "tspeg --include-grammar-comment=false src/tdf.peg src/tdf.peg.ts",
    "build": "npm run gen-parser && tsc",
    "test": "npm run gen-parser && tsc --noCheck && node --test dist/index.test.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "/dist",
    "!/dist/*.test.*"
  ],
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tsconfig/node16": "^16.1.1",
    "@tsconfig/strictest": "^2.0.2",
    "@types/node": "^20.11.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tspeg": "^3.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "wasmoon-lua5.1": "~1.17.2"
  }
}
