{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@tsconfig/node14/tsconfig.json", "@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    "outDir": "dist/cjs",
    "declaration": true,
    "noUnusedParameters": false,
    "module": "CommonJS",
    "moduleResolution": "Node"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
